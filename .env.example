# ══════════ LUMA FASHION — Environment template ══════════
# Copy file này thành .env và điền giá trị thật. KHÔNG commit .env.

# ─── Database (bắt buộc) ────────────────────────────────
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL): đổi provider trong prisma/schema.prisma thành "postgresql" rồi dùng:
# DATABASE_URL="postgresql://user:password@host:5432/luma_fashion?schema=public"

# ─── URL gốc của website (bắt buộc) ─────────────────────
SITE_URL="http://localhost:3000"
# Production: https://shop.yourdomain.com  (quyết định cookie Secure + sitemap + link email)

# ─── Auth (bắt buộc ở production) ───────────────────────
AUTH_SECRET="doi-secret-nay-toi-thieu-32-ky-tu-khi-deploy"
# Production: openssl rand -base64 32

# ─── Email — Resend (khuyến nghị) ───────────────────────
# Khi bỏ trống: email KHÔNG được gửi, chỉ ghi log (NotificationLog status=DISABLED)
RESEND_API_KEY=""
EMAIL_FROM="LUMA Fashion <noreply@luma.vn>"
EMAIL_REPLY_TO="hello@luma.vn"

# ─── Thanh toán online (chưa có merchant => để trống => cổng bị TẮT) ──
# VNPay (https://sandbox.vnpayment.vn để test)
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
# MoMo (sandbox)
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"
# ZaloPay (sandbox)
ZALOPAY_APP_ID=""
ZALOPAY_KEY1=""
ZALOPAY_KEY2=""
ZALOPAY_ENDPOINT="https://sb-openapi.zalopay.vn/v2/create"

# ─── Vận chuyển (GHN / GHTK / Viettel Post) ─────────────
GHN_TOKEN=""
GHN_SHOP_ID=""
GHN_BASE_URL="https://dev-online-gateway.ghn.vn"   # production: https://online-gateway.ghn.vn
GHTK_TOKEN=""
GHTK_BASE_URL="https://services.giaohangtietkiem.vn"   # production: https://services.giaohangtietkiem.vn
VIETTELPOST_TOKEN=""
VIETTELPOST_BASE_URL="https://partner.viettelpost.vn"
